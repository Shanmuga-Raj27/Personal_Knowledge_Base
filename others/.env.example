# ==========================================
# Core Application & Security Settings
# ==========================================
SECRET_KEY=your_secure_jwt_secret_key_here
VITE_API_URL=http://localhost:8000

# ==========================================
# Database Configuration (MySQL & SQLAlchemy)
# ==========================================
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/personal_knowledge_base
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# ==========================================
# Backblaze B2 / AWS S3 Storage
# ==========================================
AWS_ACCESS_KEY_ID=your_b2_access_key_id
AWS_SECRET_ACCESS_KEY=your_b2_secret_access_key
AWS_REGION=us-west-004
AWS_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
S3_BUCKET_NAME=your_bucket_name
S3_PRESIGNED_URL_EXPIRY=3600

# ==========================================
# Gemini AI Configuration
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_TIMEOUT_SECONDS=15.0

# RAG Embedding & Generation Settings
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_GENERATION_MODEL=gemini-3.6-flash
EMBEDDING_DIMENSIONS=768
GEMINI_EMBEDDING_BATCH_SIZE=16
GEMINI_EMBEDDING_MAX_RETRIES=3
MAX_CONCURRENT_EMBEDDING_TASKS=5

# ==========================================
# Qdrant Vector DB Configuration
# ==========================================
QDRANT_HOST=http://localhost:6333
# Existing metadata-level search collection
QDRANT_COLLECTION_NAME=document_vault
# New chunk-level production RAG collection
QDRANT_RAG_COLLECTION_NAME=document_chunks_v1
QDRANT_DISTANCE=COSINE

# ==========================================
# PDF Ingestion, Extraction & Chunking
# ==========================================
RAG_MAX_PDF_BYTES=52428800
RAG_EXTRACTION_VERSION=pdf-text-v1
RAG_CLEANING_VERSION=clean-v1
RAG_CHUNKING_VERSION=words-800-overlap-100-v1
RAG_CHUNK_WORDS=800
RAG_CHUNK_OVERLAP_WORDS=100

# ==========================================
# RAG Retrieval Controls
# ==========================================
RAG_DEFAULT_TOP_K=6
RAG_MAX_TOP_K=20
RAG_SCORE_THRESHOLD=0.35

# ==========================================
# Redis Cache Configuration
# ==========================================
RAG_CACHE_ENABLED=true
REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_TIMEOUT_SECONDS=1.0
REDIS_CONNECT_TIMEOUT_SECONDS=1.0
RAG_CACHE_TTL_SECONDS=3600
