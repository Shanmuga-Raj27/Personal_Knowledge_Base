# ==========================================
# Core Application & Security Settings
# ==========================================
SECRET_KEY=your_secure_jwt_secret_key_here
VITE_API_URL=http://localhost:8000

# ==========================================
# Database Configuration (MySQL & SQLAlchemy)
# ==========================================
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/personal_knowledge_base
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# MySQL container initialization
# MYSQL_ROOT_PASSWORD=your_root_password
# MYSQL_DATABASE=personal_knowledge_base


# ==========================================
# Backblaze B2 / AWS S3 Storage
# ==========================================
AWS_ACCESS_KEY_ID=your_b2_access_key_id
AWS_SECRET_ACCESS_KEY=your_b2_secret_access_key
AWS_REGION=your_region
AWS_ENDPOINT_URL=your_endpoint_url
S3_BUCKET_NAME=your_bucket_name
S3_PRESIGNED_URL_EXPIRY=3600

# ==========================================
# Gemini AI Configuration
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_TIMEOUT_SECONDS=15.0

# RAG Embedding & Generation Settings
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_GENERATION_MODEL=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-2.5-flash-lite,gemini-3-flash,gemma-4-26b-a4b-it
EMBEDDING_DIMENSIONS=768
GEMINI_EMBEDDING_BATCH_SIZE=64
GEMINI_EMBEDDING_MAX_RETRIES=5
MAX_CONCURRENT_EMBEDDING_TASKS=5
# Phase 4 canonical (preferred) — keep in sync with legacy above
RAG_EMBEDDING_BATCH_SIZE=64
RAG_EMBEDDING_CONCURRENCY=4
RAG_MAX_RETRIES=5
RAG_BACKOFF_BASE=1.0

# ==========================================
# Qdrant Vector DB Configuration (Qdrant Cloud)
# ==========================================
QDRANT_HOST=your_qdrant_cloud_cluster_endpoint
QDRANT_API_KEY=your_qdrant_cloud_api_key
# Existing metadata-level search collection
QDRANT_COLLECTION_NAME=document_vault
# New chunk-level production RAG collection
QDRANT_RAG_COLLECTION_NAME=document_chunks_v1
QDRANT_DISTANCE=COSINE

# ==========================================
# PDF Ingestion, Extraction & Chunking
# ==========================================
RAG_MAX_PDF_BYTES=52428800
RAG_EXTRACTION_VERSION=pdf-text-v1
RAG_CLEANING_VERSION=clean-v1
RAG_CHUNKING_VERSION=words-800-overlap-100-v1
RAG_CHUNK_WORDS=800
RAG_CHUNK_OVERLAP_WORDS=100

# ==========================================
# RAG Retrieval Controls
# ==========================================
RAG_DEFAULT_TOP_K=6
RAG_MAX_TOP_K=20
RAG_SCORE_THRESHOLD=0.35

# ==========================================
# Redis / Upstash Cache Configuration
# ==========================================
RAG_CACHE_ENABLED=true
# REDIS_URL=redis://localhost:6379/0
# REDIS_SOCKET_TIMEOUT_SECONDS=1.0
# REDIS_CONNECT_TIMEOUT_SECONDS=1.0
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
RAG_CACHE_TTL_SECONDS=3600



